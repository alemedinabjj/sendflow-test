rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function isOwner(data) {
      return isSignedIn() && data.tenantId == uid();
    }

    function incoming() {
      return request.resource.data;
    }

    function unchanged(field) {
      return incoming()[field] == resource.data[field];
    }

    function isNonEmptyString(value, maxLength) {
      return value is string && value.size() > 0 && value.size() <= maxLength;
    }

    function stampedOnCreate() {
      return incoming().createdAt == request.time && incoming().updatedAt == request.time;
    }

    function stampedOnUpdate() {
      return unchanged('createdAt') && incoming().updatedAt == request.time;
    }

    match /clients/{clientId} {
      allow read: if isSignedIn() && clientId == uid();
      allow create: if isSignedIn() && clientId == uid()
        && incoming().keys().hasOnly(['name', 'email', 'createdAt'])
        && isNonEmptyString(incoming().name, 80)
        && incoming().email is string
        && incoming().createdAt == request.time;
      allow update: if isSignedIn() && clientId == uid()
        && incoming().diff(resource.data).affectedKeys().hasOnly(['name'])
        && isNonEmptyString(incoming().name, 80);
      allow delete: if false;
    }

    function isValidConnection(data) {
      return data.keys().hasOnly(['tenantId', 'name', 'createdAt', 'updatedAt'])
        && isNonEmptyString(data.name, 60);
    }

    match /connections/{connectionId} {
      allow read, delete: if isOwner(resource.data);
      allow create: if isOwner(incoming()) && isValidConnection(incoming()) && stampedOnCreate();
      allow update: if isOwner(resource.data)
        && unchanged('tenantId')
        && isValidConnection(incoming())
        && stampedOnUpdate();
    }

    function ownsConnection(connectionId) {
      let path = /databases/$(database)/documents/connections/$(connectionId);
      return connectionId is string && exists(path) && get(path).data.tenantId == uid();
    }

    function isValidContact(data) {
      return data.keys().hasOnly(['tenantId', 'connectionId', 'name', 'phone', 'createdAt', 'updatedAt'])
        && isNonEmptyString(data.name, 80)
        && data.phone is string
        && data.phone.matches('^55[0-9]{10,11}$');
    }

    match /contacts/{contactId} {
      allow read, delete: if isOwner(resource.data);
      allow create: if isOwner(incoming())
        && ownsConnection(incoming().connectionId)
        && isValidContact(incoming())
        && stampedOnCreate();
      allow update: if isOwner(resource.data)
        && unchanged('tenantId')
        && unchanged('connectionId')
        && isValidContact(incoming())
        && stampedOnUpdate();
    }

    function isValidMessageContent(data) {
      return data.keys().hasOnly([
          'tenantId', 'connectionId', 'body', 'recipients', 'status',
          'scheduledAt', 'sentAt', 'createdAt', 'updatedAt'
        ])
        && isNonEmptyString(data.body, 1000)
        && data.recipients is list
        && data.recipients.size() > 0
        && data.recipients.size() <= 500;
    }

    function isScheduledInFuture(data) {
      return data.status == 'scheduled'
        && data.scheduledAt is timestamp
        && data.scheduledAt > request.time
        && data.sentAt == null;
    }

    function isSentNow(data) {
      return data.status == 'sent'
        && data.scheduledAt == null
        && data.sentAt == request.time;
    }

    match /messages/{messageId} {
      allow read, delete: if isOwner(resource.data);
      allow create: if isOwner(incoming())
        && ownsConnection(incoming().connectionId)
        && isValidMessageContent(incoming())
        && (isScheduledInFuture(incoming()) || isSentNow(incoming()))
        && stampedOnCreate();
      // status/sentAt are owned by the dispatcher; clients may only reshape a still-pending message
      allow update: if isOwner(resource.data)
        && resource.data.status == 'scheduled'
        && incoming().diff(resource.data).affectedKeys()
             .hasOnly(['body', 'recipients', 'scheduledAt', 'updatedAt'])
        && isValidMessageContent(incoming())
        && isScheduledInFuture(incoming())
        && stampedOnUpdate();
    }
  }
}
